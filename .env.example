# Supabase Configuration for Anonymous Analytics
# In production, replace with your actual Supabase project URL and anon/public key.
# If left blank or unconfigured, the app falls back gracefully without breaking.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Port
PORT=3000
NODE_ENV=development
